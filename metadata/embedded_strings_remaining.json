    "ja": "やった！ベストピッチ！"
  },
  {
    "file": "TUTORIAL.OVL",
    "offset": 191819,
    "ja": "最高！スゴイ球威だよ！"
  },
  {
    "file": "TUTORIAL.OVL",
    "offset": 192120,
    "ja": "ナイスコントロール！"
  },
  {
    "file": "TUTORIAL.OVL",
    "offset": 192421,
    "ja": "いいコースにきてるね！"
